# Copy this file to .env and fill in your own keys.

# Get a free NASA key at https://api.nasa.gov/
NASA_API_KEY=your_nasa_key_here

# The APOD endpoint URL (kept in env so it's easy to change).
NUXT_NASA_APOD_API_URL=https://api.nasa.gov/planetary/apod

# Get a free Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
